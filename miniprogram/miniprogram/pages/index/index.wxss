.page {
  padding: 24rpx 28rpx 60rpx;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 52rpx;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.section {
  margin-bottom: 40rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty {
  padding: 36rpx 24rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  background: var(--paper-2);
  border-radius: 24rpx;
  border: 1rpx dashed var(--line);
}

.works {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.work {
  position: relative;
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.badge {
  align-self: flex-start;
  font-size: 20rpx;
  color: var(--ink-2);
  background: var(--paper-3);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  margin-bottom: 10rpx;
}

.w-name {
  font-size: 28rpx;
  color: var(--ink);
}

.del {
  position: absolute;
  right: 20rpx;
  top: 18rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.libs {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.lib {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.lib-name {
  font-size: 30rpx;
  color: var(--ink);
}

.lib-size {
  font-size: 22rpx;
  color: var(--sakura);
  margin-top: 2rpx;
}

.lib-desc {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  line-height: 1.5;
}

.sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.size {
  padding: 18rpx 0;
  width: calc(33.33% - 11rpx);
  text-align: center;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.card {
  background: #fff;
  border: 1rpx dashed var(--line);
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
}

.foot {
  padding: 20rpx 8rpx;
  text-align: center;
}
