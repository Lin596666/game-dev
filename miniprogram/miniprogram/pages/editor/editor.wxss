.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
}

.topbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.size {
  font-size: 22rpx;
  color: var(--ink-3);
}

.act {
  font-size: 24rpx;
  color: var(--ink);
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
}

.cv {
  width: 100%;
  height: 100%;
}

.float {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 253, 250, 0.92);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.fbtn {
  font-size: 24rpx;
  color: var(--ink);
  padding: 0 8rpx;
}

.zoom {
  font-size: 20rpx;
  color: var(--ink-3);
  min-width: 56rpx;
  text-align: right;
}

.guide-tip {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: rgba(255, 253, 250, 0.92);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.tools {
  display: flex;
  gap: 10rpx;
  padding: 14rpx 0 10rpx;
  overflow-x: auto;
}

.tool {
  flex: none;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 10rpx 20rpx;
}

.tool.on {
  color: var(--ink);
  border-color: var(--sakura);
  background: #FDF1F2;
}

.setbar {
  display: flex;
  gap: 10rpx;
  padding: 4rpx 0 10rpx;
}

.pill {
  font-size: 22rpx;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.pill.on {
  color: #fff;
  background: var(--ink);
  border-color: var(--ink);
}

.swatches {
  width: 100%;
  white-space: nowrap;
}

.swatch-wrap {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 4rpx;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

.swatch.on {
  border-color: var(--ink);
}

/* 更多面板 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(58, 52, 46, 0.28);
  z-index: 20;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 76vh;
  overflow-y: auto;
  padding: 18px 18px calc(28px + env(safe-area-inset-bottom));
  background: #FBF7F1;
  border-radius: 22px 22px 0 0;
  box-shadow: 0 -8px 30px rgba(58, 52, 46, 0.16);
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.22s ease, opacity 0.22s ease;
  pointer-events: none;
}
.sheet.open {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.sheet-title {
  font-size: 16px;
  font-weight: 600;
  color: #3A342E;
  letter-spacing: 0.06em;
}
.sheet-close {
  font-size: 13px;
  color: #9A9086;
}
.group {
  padding: 12px 0;
  border-bottom: 1px dashed #E4DBCD;
}
.group-title {
  display: block;
  font-size: 12px;
  color: #6D6459;
  margin-bottom: 8px;
  letter-spacing: 0.08em;
}
.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.hint {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  line-height: 1.6;
  color: #9A9086;
}
