<view class="page">
  <view class="topbar">
    <input class="name" value="{{name}}" placeholder="给作品起个名字" bindinput="onNameInput" confirm-type="done" />
    <text class="size">{{sizeText}}</text>
    <view class="act" bindtap="saveNow">保存</view>
    <view class="act" bindtap="copyList">清单</view>
    <view class="act" bindtap="exportImage">导出</view>
    <view class="act" bindtap="openMore">更多</view>
  </view>

  <view class="stage">
    <canvas
      id="cv"
      type="2d"
      class="cv"
      disable-scroll="{{true}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    ></canvas>

    <view class="float">
      <view class="fbtn" bindtap="zoomOut">－</view>
      <view class="fbtn" bindtap="zoomIn">＋</view>
      <view class="fbtn" bindtap="fitView">适配</view>
      <text class="zoom">{{zoomText}}</text>
    </view>

    <view wx:if="{{guideMode}}" class="guide-tip">跟拼模式：点一颗珠子就标记为已拼（{{progress}}%）</view>
  </view>

  <view class="tools">
    <view
      wx:for="{{tools}}"
      wx:key="id"
      class="tool {{tool === item.id ? 'on' : ''}}"
      bindtap="onTool"
      data-id="{{item.id}}"
    >{{item.label}}</view>
    <view class="tool {{showNumbers ? 'on' : ''}}" bindtap="toggleNumbers">色号</view>
    <view class="tool {{guideMode ? 'on' : ''}}" bindtap="toggleGuide">跟拼</view>
    <view class="tool {{finishId !== 'raw' ? 'on' : ''}}" bindtap="chooseFinish">{{finishId === 'raw' ? '烫法' : finishName}}</view>
    <view class="tool" bindtap="undoAction">撤销</view>
    <view class="tool" bindtap="redoAction">重做</view>
  </view>

  <view wx:if="{{guideMode}}" class="setbar">
    <picker mode="selector" range="{{guideOptions}}" range-key="label" bindchange="onGuideColorPick">
      <view class="pill on">只看：{{guideLabel}}</view>
    </picker>
    <view class="pill">已拼 {{progress}}%</view>
    <view class="pill {{stepMode ? 'on' : ''}}" bindtap="toggleStep">分步</view>
    <view wx:if="{{stepMode}}" class="pill" bindtap="prevStep">上一颗</view>
    <view wx:if="{{stepMode}}" class="pill" bindtap="nextStep">下一颗（还剩 {{stepTotal}}）</view>
  </view>

  <view class="setbar">
    <view
      wx:for="{{sets}}"
      wx:key="id"
      class="pill {{setIndex === index ? 'on' : ''}}"
      bindtap="onSetIndex"
      data-index="{{index}}"
    >{{item.label}}</view>
  </view>

  <scroll-view class="swatches" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="swatch-wrap">
      <view
        wx:for="{{swatches}}"
        wx:key="id"
        class="swatch {{colorId === item.id ? 'on' : ''}}"
        style="background: {{item.hex}}"
        bindtap="onPickColor"
        data-id="{{item.id}}"
      ></view>
    </view>
  </scroll-view>

  <view wx:if="{{moreOpen}}" class="mask" bindtap="closeMore"></view>
  <view class="sheet {{moreOpen ? 'open' : ''}}">
    <view class="sheet-head">
      <text class="sheet-title">更多</text>
      <text class="sheet-close" bindtap="closeMore">收起</text>
    </view>

    <view class="group">
      <text class="group-title">对称绘制</text>
      <view class="pills">
        <view class="pill {{symmetry === 'none' ? 'on' : ''}}" bindtap="setSymmetry" data-v="none">不对称</view>
        <view class="pill {{symmetry === 'x' ? 'on' : ''}}" bindtap="setSymmetry" data-v="x">左右对称</view>
        <view class="pill {{symmetry === 'y' ? 'on' : ''}}" bindtap="setSymmetry" data-v="y">上下对称</view>
        <view class="pill {{symmetry === 'quad' ? 'on' : ''}}" bindtap="setSymmetry" data-v="quad">四向对称</view>
      </view>
    </view>

    <view class="group">
      <text class="group-title">整张图纸</text>
      <view class="pills">
        <view class="pill" bindtap="transformGrid" data-kind="flipX">左右翻转</view>
        <view class="pill" bindtap="transformGrid" data-kind="flipY">上下翻转</view>
        <view class="pill" bindtap="transformGrid" data-kind="rotate180">旋转 180°</view>
        <view class="pill" bindtap="rotate90Action">旋转 90°</view>
        <view class="pill" bindtap="trimGrid">裁掉空白</view>
        <view class="pill" bindtap="clearGrid">清空画布</view>
      </view>
      <text class="hint">旋转 90° 与裁掉空白会重置跟拼进度。</text>
      <text class="group-title" style="margin-top: 12px">重设画布（内容居中保留）</text>
      <view class="pills">
        <view class="pill" bindtap="onResizeTap" data-size="29">29×29</view>
        <view class="pill" bindtap="onResizeTap" data-size="48">48×48</view>
        <view class="pill" bindtap="onResizeTap" data-size="58">58×58</view>
        <view class="pill" bindtap="onResizeTap" data-size="72">72×72</view>
        <view class="pill" bindtap="onResizeTap" data-size="96">96×96</view>
      </view>
      <picker mode="selector" range="{{usageOptions}}" range-key="label" bindchange="onReplacePick">
        <view class="pill" style="margin-top: 8px">配色替换：把某个色号换成当前色</view>
      </picker>
    </view>

    <view class="group">
      <text class="group-title">跟拼辅助</text>
      <view class="pills">
        <view class="pill {{showBoards ? 'on' : ''}}" bindtap="toggleBoards">豆板分块线</view>
        <view class="pill {{stepMode ? 'on' : ''}}" bindtap="toggleStep">分步引导</view>
      </view>
      <text class="hint">{{stepMode ? '分步引导开着：光标会停在下一颗要拼的珠子上，还剩 ' + stepTotal + ' 颗' : '打开分步引导，光标会告诉你下一颗拼哪里'}}</text>
    </view>

    <view class="group">
      <text class="group-title">分享与备份</text>
      <view class="pills">
        <view class="pill" bindtap="copyShare">复制分享码</view>
        <view class="pill" bindtap="importShare">从剪贴板导入</view>
        <view class="pill" bindtap="copyProject">复制工程文件</view>
        <view class="pill" bindtap="copyPurchase">采购清单</view>
      </view>
      <text class="hint">分享码和工程文件都是纯文本，粘到微信里发给朋友就行，我不需要服务器。</text>
    </view>

    <text class="hint">这次拼了 {{minutes}} 分钟 · 每 45 分钟会震一下提醒你起身</text>
  </view>
</view>
