{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bead Atelier",
  "version": "0.1.0",
  "identifier": "com.lin596666.beadatelier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拼豆工房",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "拼豆工房 · 随手拼一颗",
    "longDescription": "单机拼豆设计工具：自由拼、照图纸拼、导入图片转图纸、导出 PNG 与色号清单。数据全部存在本机。"
  }
}
